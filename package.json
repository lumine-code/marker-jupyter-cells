{
  "name": "scrollmap-jove-repl",
  "author": "lumine-code",
  "description": "Show cell markers on the scrollbar.",
  "repository": "https://github.com/lumine-code/scrollmap-jove-repl",
  "bugs": {
    "url": "https://github.com/lumine-code/scrollmap-jove-repl/issues"
  },
  "keywords": [
    "overview-ruler",
    "gutter",
    "annotation",
    "decoration",
    "jupyter",
    "cell"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../scrollmap-jove-repl/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "jove.breakpoints": {
      "versions": {
        "^1.0.0": "consumeJoveService"
      }
    }
  },
  "providedServices": {
    "scrollmap": {
      "versions": {
        "1.0.0": "provideScrollmap"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "threshold": {
      "title": "Threshold",
      "description": "Hide markers if count exceeds this value. Zero means no limit.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  }
}
